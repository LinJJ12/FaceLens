# 复制为 .env 后按需修改
# cp .env.example .env   (Linux/macOS)
# copy .env.example .env (Windows)

# 必填：JWT 签名密钥（部署前请改为足够随机的强密钥）
JWT_SECRET_KEY=please-change-me-to-a-long-random-string

# 可选：前端对外端口（默认 8080）
FRONTEND_PORT=8080

# 可选：自定义 SQLite / 其他数据库连接（默认使用容器内 backend/data/db/）
# DATABASE_URL=sqlite:////app/backend/data/db/emotion_recognition.db

# 可选：是否种入演示账号 admin/admin123、test/test123（公开部署务必设为 false）
SEED_DEMO_USERS=true

# 可选：CORS 允许来源（逗号分隔；默认 * 开箱即用，生产建议改为前端地址）
# CORS_ORIGINS=http://localhost:8080
